rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable primitives
    function isValidId(id) {
      return id is string && id.size() >= 2 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedEmail() && (
        request.auth.token.email == 'wahyudidinar7@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidRegistrationFields(data) {
      return data.registrationCode is string &&
        data.registrationCode.size() >= 8 &&
        data.registrationCode.size() <= 24 &&
        data.registrationCode.matches('^PPDB-[0-9]{4}-[A-Z0-9]{4,8}$') &&
        data.childName is string &&
        data.childName.size() >= 2 &&
        data.childName.size() <= 100 &&
        data.birthDate is string &&
        data.birthDate.size() == 10 &&
        data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.gender in ['Laki-laki', 'Perempuan'] &&
        data.programCode is string &&
        data.programCode.size() >= 2 &&
        data.programCode.size() <= 40 &&
        data.programCode.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.fatherName is string &&
        data.fatherName.size() >= 2 &&
        data.fatherName.size() <= 100 &&
        data.motherName is string &&
        data.motherName.size() >= 2 &&
        data.motherName.size() <= 100 &&
        data.parentWhatsapp is string &&
        data.parentWhatsapp.size() >= 9 &&
        data.parentWhatsapp.size() <= 18 &&
        data.parentWhatsapp.matches('^[0-9+\\-\\s]{9,18}$') &&
        data.address is string &&
        data.address.size() >= 5 &&
        data.address.size() <= 300 &&
        (!('previousSchool' in data) || (data.previousSchool is string && data.previousSchool.size() <= 120)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 400)) &&
        data.wantsTrial is bool;
    }

    function isValidRegistrationCreate(data) {
      return data.keys().hasAll([
        'registrationCode',
        'childName',
        'birthDate',
        'gender',
        'programCode',
        'fatherName',
        'motherName',
        'parentWhatsapp',
        'address',
        'wantsTrial',
        'status',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'registrationCode',
        'childName',
        'birthDate',
        'gender',
        'programCode',
        'fatherName',
        'motherName',
        'parentWhatsapp',
        'address',
        'previousSchool',
        'notes',
        'wantsTrial',
        'status',
        'trialDate',
        'adminNotes',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidRegistrationFields(data) &&
      (
        (data.status == 'menunggu' && !('trialDate' in data) && !('adminNotes' in data)) ||
        (isAdmin() && data.status in ['menunggu', 'jadwal_trial', 'diterima', 'batal'] &&
          (!('trialDate' in data) || (data.trialDate is string && data.trialDate.size() <= 40)) &&
          (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 300)))
      ) &&
      data.createdAt == request.time &&
      data.updatedAt == request.time;
    }

    function isValidRegistrationUpdate(data) {
      return data.keys().hasAll([
        'registrationCode',
        'childName',
        'birthDate',
        'gender',
        'programCode',
        'fatherName',
        'motherName',
        'parentWhatsapp',
        'address',
        'wantsTrial',
        'status',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'registrationCode',
        'childName',
        'birthDate',
        'gender',
        'programCode',
        'fatherName',
        'motherName',
        'parentWhatsapp',
        'address',
        'previousSchool',
        'notes',
        'wantsTrial',
        'status',
        'trialDate',
        'adminNotes',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidRegistrationFields(data) &&
      data.status in ['menunggu', 'jadwal_trial', 'diterima', 'batal'] &&
      (!('trialDate' in data) || (data.trialDate is string && data.trialDate.size() <= 40)) &&
      (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 300)) &&
      data.registrationCode == existing().registrationCode &&
      data.createdAt == existing().createdAt &&
      data.updatedAt == request.time;
    }

    function isValidProgramQuota(data, programCode) {
      return data.keys().hasAll(['programCode', 'capacity', 'enrolledCount', 'updatedAt']) &&
        data.keys().hasOnly(['programCode', 'capacity', 'enrolledCount', 'lastRegistrationId', 'updatedAt']) &&
        data.programCode == programCode &&
        isValidId(data.programCode) &&
        data.programCode.size() <= 40 &&
        data.capacity is int &&
        data.capacity >= 1 &&
        data.capacity <= 100 &&
        data.enrolledCount is int &&
        data.enrolledCount >= 0 &&
        data.enrolledCount <= data.capacity &&
        (!('lastRegistrationId' in data) || isValidId(data.lastRegistrationId)) &&
        data.updatedAt == request.time;
    }

    function isValidTeacher(data) {
      return data.keys().hasAll(['name', 'role', 'slogan', 'experience', 'photo', 'badgeColor', 'initials', 'sortOrder', 'updatedAt']) &&
        data.keys().hasOnly(['name', 'role', 'slogan', 'experience', 'photo', 'badgeColor', 'initials', 'sortOrder', 'updatedAt']) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.role is string && data.role.size() >= 2 && data.role.size() <= 80 &&
        data.slogan is string && data.slogan.size() >= 2 && data.slogan.size() <= 200 &&
        data.experience is string && data.experience.size() >= 2 && data.experience.size() <= 80 &&
        data.photo is string && data.photo.size() >= 1 && data.photo.size() <= 400 &&
        data.badgeColor is string && data.badgeColor.size() >= 2 && data.badgeColor.size() <= 40 &&
        data.initials is string && data.initials.size() >= 1 && data.initials.size() <= 4 &&
        data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 1000 &&
        data.updatedAt == request.time;
    }

    function isValidGalleryItem(data) {
      return data.keys().hasAll(['title', 'category', 'description', 'image', 'alt', 'sortOrder', 'updatedAt']) &&
        data.keys().hasOnly(['title', 'category', 'description', 'image', 'alt', 'sortOrder', 'updatedAt']) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
        data.category in ['Belajar', 'Bermain', 'Mengaji', 'Pentas Seni', 'Field Trip'] &&
        data.description is string && data.description.size() >= 2 && data.description.size() <= 300 &&
        data.image is string && data.image.size() >= 1 && data.image.size() <= 400 &&
        data.alt is string && data.alt.size() >= 2 && data.alt.size() <= 200 &&
        data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 1000 &&
        data.updatedAt == request.time;
    }

    function isValidTestimonial(data) {
      return data.keys().hasAll(['parentName', 'childInfo', 'rating', 'quote', 'avatarColor', 'initials', 'sortOrder', 'updatedAt']) &&
        data.keys().hasOnly(['parentName', 'childInfo', 'rating', 'quote', 'avatarColor', 'initials', 'sortOrder', 'updatedAt']) &&
        data.parentName is string && data.parentName.size() >= 2 && data.parentName.size() <= 80 &&
        data.childInfo is string && data.childInfo.size() >= 2 && data.childInfo.size() <= 80 &&
        data.rating is int && data.rating >= 1 && data.rating <= 5 &&
        data.quote is string && data.quote.size() >= 5 && data.quote.size() <= 400 &&
        data.avatarColor is string && data.avatarColor.size() >= 2 && data.avatarColor.size() <= 40 &&
        data.initials is string && data.initials.size() >= 1 && data.initials.size() <= 4 &&
        data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 1000 &&
        data.updatedAt == request.time;
    }

    function isValidFaq(data) {
      return data.keys().hasAll(['question', 'answer', 'sortOrder', 'updatedAt']) &&
        data.keys().hasOnly(['question', 'answer', 'sortOrder', 'updatedAt']) &&
        data.question is string && data.question.size() >= 5 && data.question.size() <= 200 &&
        data.answer is string && data.answer.size() >= 5 && data.answer.size() <= 600 &&
        data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 1000 &&
        data.updatedAt == request.time;
    }

    function isValidAdvantage(data) {
      return data.keys().hasAll(['emoji', 'title', 'description', 'bgClass', 'borderClass', 'sortOrder', 'updatedAt']) &&
        data.keys().hasOnly(['emoji', 'title', 'description', 'bgClass', 'borderClass', 'sortOrder', 'updatedAt']) &&
        data.emoji is string && data.emoji.size() >= 1 && data.emoji.size() <= 16 &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 100 &&
        data.description is string && data.description.size() >= 5 && data.description.size() <= 400 &&
        data.bgClass is string && data.bgClass.size() >= 2 && data.bgClass.size() <= 40 &&
        data.borderClass is string && data.borderClass.size() >= 2 && data.borderClass.size() <= 40 &&
        data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 1000 &&
        data.updatedAt == request.time;
    }

    function isValidProgram(data) {
      return data.keys().hasAll([
          'code',
          'name',
          'ageRange',
          'scheduleHours',
          'maxPerClass',
          'defaultEnrolled',
          'feeSummary',
          'registrationFee',
          'monthlyFee',
          'accentBg',
          'accentBorder',
          'buttonBg',
          'emoji',
          'summary',
          'highlights',
          'weeklySchedule',
          'sortOrder',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'code',
          'name',
          'ageRange',
          'scheduleHours',
          'maxPerClass',
          'defaultEnrolled',
          'feeSummary',
          'registrationFee',
          'monthlyFee',
          'accentBg',
          'accentBorder',
          'buttonBg',
          'emoji',
          'summary',
          'highlights',
          'weeklySchedule',
          'sortOrder',
          'updatedAt'
        ]) &&
        data.code is string && isValidId(data.code) && data.code.size() <= 40 &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.ageRange is string && data.ageRange.size() >= 2 && data.ageRange.size() <= 60 &&
        data.scheduleHours is string && data.scheduleHours.size() >= 2 && data.scheduleHours.size() <= 100 &&
        data.maxPerClass is int && data.maxPerClass >= 1 && data.maxPerClass <= 100 &&
        data.defaultEnrolled is int && data.defaultEnrolled >= 0 && data.defaultEnrolled <= data.maxPerClass &&
        data.feeSummary is string && data.feeSummary.size() >= 2 && data.feeSummary.size() <= 80 &&
        data.registrationFee is string && data.registrationFee.size() >= 2 && data.registrationFee.size() <= 140 &&
        data.monthlyFee is string && data.monthlyFee.size() >= 2 && data.monthlyFee.size() <= 140 &&
        data.accentBg is string && data.accentBg.size() >= 2 && data.accentBg.size() <= 40 &&
        data.accentBorder is string && data.accentBorder.size() >= 2 && data.accentBorder.size() <= 40 &&
        data.buttonBg is string && data.buttonBg.size() >= 2 && data.buttonBg.size() <= 120 &&
        data.emoji is string && data.emoji.size() >= 1 && data.emoji.size() <= 16 &&
        data.summary is string && data.summary.size() >= 5 && data.summary.size() <= 400 &&
        data.highlights is list && data.highlights.size() >= 1 && data.highlights.size() <= 10 &&
        data.highlights[0] is string && data.highlights[0].size() >= 1 && data.highlights[0].size() <= 160 &&
        data.weeklySchedule is list && data.weeklySchedule.size() >= 1 && data.weeklySchedule.size() <= 7 &&
        data.weeklySchedule[0] is map &&
        data.weeklySchedule[0].day is string && data.weeklySchedule[0].day.size() >= 1 && data.weeklySchedule[0].day.size() <= 30 &&
        data.weeklySchedule[0].activity is string && data.weeklySchedule[0].activity.size() >= 1 && data.weeklySchedule[0].activity.size() <= 200 &&
        data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 1000 &&
        data.updatedAt == request.time;
    }

    function isValidTimelineStep(data) {
      return data.keys().hasAll(['time', 'emoji', 'title', 'description', 'color', 'sortOrder', 'updatedAt']) &&
        data.keys().hasOnly(['time', 'emoji', 'title', 'description', 'color', 'sortOrder', 'updatedAt']) &&
        data.time is string && data.time.size() >= 2 && data.time.size() <= 20 &&
        data.emoji is string && data.emoji.size() >= 1 && data.emoji.size() <= 16 &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 100 &&
        data.description is string && data.description.size() >= 5 && data.description.size() <= 300 &&
        data.color is string && data.color.size() >= 2 && data.color.size() <= 60 &&
        data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 1000 &&
        data.updatedAt == request.time;
    }

    function isValidSchoolInfo(data) {
      return data.keys().hasAll([
          'name',
          'shortTagline',
          'npsn',
          'accreditation',
          'curriculum',
          'foundedYear',
          'experienceYears',
          'studentCount',
          'teacherCount',
          'ratioText',
          'principalName',
          'principalQuote',
          'address',
          'whatsappRaw',
          'whatsappDisplay',
          'instagramHandle',
          'facebookName',
          'youtubeName',
          'email',
          'schoolHoursA',
          'schoolHoursB',
          'serviceHours',
          'ppdbDeadlineIso',
          'youtubeVideoId',
          'mapsEmbedUrl',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'name',
          'shortTagline',
          'npsn',
          'accreditation',
          'curriculum',
          'foundedYear',
          'experienceYears',
          'studentCount',
          'teacherCount',
          'ratioText',
          'principalName',
          'principalQuote',
          'principalPhoto',
          'address',
          'whatsappRaw',
          'whatsappDisplay',
          'instagramHandle',
          'facebookName',
          'youtubeName',
          'email',
          'schoolHoursA',
          'schoolHoursB',
          'serviceHours',
          'ppdbDeadlineIso',
          'youtubeVideoId',
          'videoThumbnail',
          'mapsEmbedUrl',
          'heroBadge',
          'heroTitle',
          'heroSubtitle',
          'heroImage',
          'updatedAt'
        ]) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.shortTagline is string && data.shortTagline.size() >= 2 && data.shortTagline.size() <= 140 &&
        data.npsn is string && data.npsn.size() >= 2 && data.npsn.size() <= 30 &&
        data.accreditation is string && data.accreditation.size() >= 1 && data.accreditation.size() <= 60 &&
        data.curriculum is string && data.curriculum.size() >= 2 && data.curriculum.size() <= 80 &&
        data.foundedYear is int && data.foundedYear >= 1900 && data.foundedYear <= 2100 &&
        data.experienceYears is string && data.experienceYears.size() >= 1 && data.experienceYears.size() <= 40 &&
        data.studentCount is string && data.studentCount.size() >= 1 && data.studentCount.size() <= 40 &&
        data.teacherCount is string && data.teacherCount.size() >= 1 && data.teacherCount.size() <= 40 &&
        data.ratioText is string && data.ratioText.size() >= 1 && data.ratioText.size() <= 30 &&
        data.principalName is string && data.principalName.size() >= 2 && data.principalName.size() <= 100 &&
        data.principalQuote is string && data.principalQuote.size() >= 5 && data.principalQuote.size() <= 600 &&
        (!('principalPhoto' in data) || (data.principalPhoto is string && data.principalPhoto.size() <= 400)) &&
        data.address is string && data.address.size() >= 5 && data.address.size() <= 300 &&
        data.whatsappRaw is string && data.whatsappRaw.size() >= 8 && data.whatsappRaw.size() <= 20 &&
        data.whatsappDisplay is string && data.whatsappDisplay.size() >= 8 && data.whatsappDisplay.size() <= 25 &&
        data.instagramHandle is string && data.instagramHandle.size() <= 60 &&
        data.facebookName is string && data.facebookName.size() <= 80 &&
        data.youtubeName is string && data.youtubeName.size() <= 80 &&
        data.email is string && data.email.size() <= 120 &&
        data.schoolHoursA is string && data.schoolHoursA.size() <= 120 &&
        data.schoolHoursB is string && data.schoolHoursB.size() <= 120 &&
        data.serviceHours is string && data.serviceHours.size() <= 140 &&
        data.ppdbDeadlineIso is string && data.ppdbDeadlineIso.size() <= 40 &&
        data.youtubeVideoId is string && data.youtubeVideoId.size() <= 60 &&
        (!('videoThumbnail' in data) || (data.videoThumbnail is string && data.videoThumbnail.size() <= 400)) &&
        data.mapsEmbedUrl is string && data.mapsEmbedUrl.size() <= 500 &&
        (!('heroBadge' in data) || (data.heroBadge is string && data.heroBadge.size() <= 120)) &&
        (!('heroTitle' in data) || (data.heroTitle is string && data.heroTitle.size() <= 160)) &&
        (!('heroSubtitle' in data) || (data.heroSubtitle is string && data.heroSubtitle.size() <= 400)) &&
        (!('heroImage' in data) || (data.heroImage is string && data.heroImage.size() <= 400)) &&
        data.updatedAt == request.time;
    }

    // PPDB Registrations (PII isolated: admin only for read/update/delete; validated public/admin create)
    match /ppdb_registrations/{registrationId} {
      allow get: if isValidId(registrationId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(registrationId) && isValidRegistrationCreate(incoming());
      allow update: if isValidId(registrationId) &&
        isAdmin() &&
        isValidRegistrationUpdate(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'childName',
          'birthDate',
          'gender',
          'programCode',
          'fatherName',
          'motherName',
          'parentWhatsapp',
          'address',
          'previousSchool',
          'notes',
          'wantsTrial',
          'status',
          'trialDate',
          'adminNotes',
          'updatedAt'
        ]);
      allow delete: if isValidId(registrationId) && isAdmin();
    }

    // Public non-PII Program Quotas (kb, kelompok_a, kelompok_b, or custom programs)
    match /ppdb_stats/{programCode} {
      allow get: if isValidId(programCode) && programCode.size() <= 40;
      allow list: if true;
      allow create: if isValidId(programCode) && programCode.size() <= 40 &&
        isAdmin() &&
        isValidProgramQuota(incoming(), programCode);
      allow update: if isValidId(programCode) && programCode.size() <= 40 &&
        isValidProgramQuota(incoming(), programCode) && (
          isAdmin() ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['enrolledCount', 'lastRegistrationId', 'updatedAt']) &&
            'lastRegistrationId' in incoming() &&
            incoming().capacity == existing().capacity &&
            incoming().enrolledCount == existing().enrolledCount + 1 &&
            !exists(/databases/$(database)/documents/ppdb_registrations/$(incoming().lastRegistrationId)) &&
            existsAfter(/databases/$(database)/documents/ppdb_registrations/$(incoming().lastRegistrationId)) &&
            getAfter(/databases/$(database)/documents/ppdb_registrations/$(incoming().lastRegistrationId)).data.programCode == programCode
          )
        );
      allow delete: if isValidId(programCode) && isAdmin();
    }

    // Public-read / Admin-write school identity & principal settings
    match /site_settings/{settingId} {
      allow get: if settingId == 'school_info';
      allow list: if true;
      allow create: if settingId == 'school_info' && isAdmin() && isValidSchoolInfo(incoming());
      allow update: if settingId == 'school_info' && isAdmin() && isValidSchoolInfo(incoming());
      allow delete: if false;
    }

    // Public-read / Admin-write school advantages, programs, and timeline
    match /site_advantages/{advantageId} {
      allow get: if isValidId(advantageId);
      allow list: if true;
      allow create: if isValidId(advantageId) && isAdmin() && isValidAdvantage(incoming());
      allow update: if isValidId(advantageId) && isAdmin() && isValidAdvantage(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['emoji', 'title', 'description', 'bgClass', 'borderClass', 'sortOrder', 'updatedAt']);
      allow delete: if isValidId(advantageId) && isAdmin();
    }

    match /site_programs/{programId} {
      allow get: if isValidId(programId);
      allow list: if true;
      allow create: if isValidId(programId) && isAdmin() && isValidProgram(incoming());
      allow update: if isValidId(programId) && isAdmin() && isValidProgram(incoming()) &&
        incoming().code == existing().code &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'ageRange',
          'scheduleHours',
          'maxPerClass',
          'defaultEnrolled',
          'feeSummary',
          'registrationFee',
          'monthlyFee',
          'accentBg',
          'accentBorder',
          'buttonBg',
          'emoji',
          'summary',
          'highlights',
          'weeklySchedule',
          'sortOrder',
          'updatedAt'
        ]);
      allow delete: if isValidId(programId) && isAdmin();
    }

    match /site_timeline/{stepId} {
      allow get: if isValidId(stepId);
      allow list: if true;
      allow create: if isValidId(stepId) && isAdmin() && isValidTimelineStep(incoming());
      allow update: if isValidId(stepId) && isAdmin() && isValidTimelineStep(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['time', 'emoji', 'title', 'description', 'color', 'sortOrder', 'updatedAt']);
      allow delete: if isValidId(stepId) && isAdmin();
    }

    // Public-read / Admin-write school content collections
    match /site_teachers/{teacherId} {
      allow get: if isValidId(teacherId);
      allow list: if true;
      allow create: if isValidId(teacherId) && isAdmin() && isValidTeacher(incoming());
      allow update: if isValidId(teacherId) && isAdmin() && isValidTeacher(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'slogan', 'experience', 'photo', 'badgeColor', 'initials', 'sortOrder', 'updatedAt']);
      allow delete: if isValidId(teacherId) && isAdmin();
    }

    match /site_gallery/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if true;
      allow create: if isValidId(itemId) && isAdmin() && isValidGalleryItem(incoming());
      allow update: if isValidId(itemId) && isAdmin() && isValidGalleryItem(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'description', 'image', 'alt', 'sortOrder', 'updatedAt']);
      allow delete: if isValidId(itemId) && isAdmin();
    }

    match /site_testimonials/{testimonialId} {
      allow get: if isValidId(testimonialId);
      allow list: if true;
      allow create: if isValidId(testimonialId) && isAdmin() && isValidTestimonial(incoming());
      allow update: if isValidId(testimonialId) && isAdmin() && isValidTestimonial(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['parentName', 'childInfo', 'rating', 'quote', 'avatarColor', 'initials', 'sortOrder', 'updatedAt']);
      allow delete: if isValidId(testimonialId) && isAdmin();
    }

    match /site_faqs/{faqId} {
      allow get: if isValidId(faqId);
      allow list: if true;
      allow create: if isValidId(faqId) && isAdmin() && isValidFaq(incoming());
      allow update: if isValidId(faqId) && isAdmin() && isValidFaq(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['question', 'answer', 'sortOrder', 'updatedAt']);
      allow delete: if isValidId(faqId) && isAdmin();
    }

    // Admins collection (only readable by self or admin; writable only by existing admin)
    match /admins/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isValidId(userId) && isAdmin();
    }
  }
}
